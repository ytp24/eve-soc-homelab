      <textobject id="37" name="Doc-Subnets-Body" type="text">
        <data>&lt;div id="customText37" class="customShape customText context-menu" data-path="37" style="display:inline;position:absolute;left:1195px;top:130px;cursor:move;z-index:15;"&gt;&lt;p align="left" style="vertical-align:top;color:#212529;background-color:transparent;font-size:11px;line-height:1.5;font-family:monospace;"&gt;• WAN / Untrusted : 172.31.255.0/24 (Kali: .100 | GW: .1 | OPNsense: .50)&lt;br/&gt;• VLAN 10 Corp LAN: 10.10.10.0/24   (Client PC: .50 | Gateway: 10.10.10.1)&lt;br/&gt;• VLAN 20 DMZ Web : 10.10.20.0/24   (Web Server: .50 | Gateway: 10.10.20.1)&lt;br/&gt;• VLAN 30 OT / ICS: 10.10.30.0/24   (Modbus PLC: .50 | Gateway: 10.10.30.1)&lt;br/&gt;• VLAN 99 Mgmt/SPAN: 10.10.99.0/24  (Cisco SPAN Port e0/3 Mirror)&lt;/p&gt;&lt;/div&gt;</data>
      </textobject>
